@model Product

@{
    ViewData["Title"] = Model.Name;
}

<div class="container-fluid page-header mb-5 wow fadeIn" data-wow-delay="0.1s">
    <div class="container">
        <h1 class="display-3 mb-3 animated slideInDown">@Model.Name</h1>
        <nav aria-label="breadcrumb animated slideInDown">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a class="text-body" asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a class="text-body" asp-controller="HangHoa" asp-action="Index">Products</a></li>
                <li class="breadcrumb-item text-dark active" aria-current="page">@Model.Name</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container-xxl py-5">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6 wow fadeIn" data-wow-delay="0.1s">
                <div class="bg-light overflow-hidden">
                    <img class="img-fluid w-100" src="@Url.Content(Model.ImageUrl)" alt="@Model.Name">
                </div>
            </div>
            <div class="col-lg-6 wow fadeIn" data-wow-delay="0.5s">
                <span class="bg-secondary rounded text-white py-1 px-3">@Model.Badge</span>
                <h1 class="display-5 my-4">@Model.Name</h1>
                <p class="mb-4">@Model.Description</p>
                <h3 class="text-primary mb-4">@Model.Price.ToString("N0") VND</h3>
                <p class="text-body text-decoration-line-through">@Model.OldPrice.ToString("N0") VND</p>
                <div class="d-flex gap-3 mt-4">
                    <form asp-controller="Cart" asp-action="Add" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <input type="hidden" name="quantity" value="1" />
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                        <button type="submit" class="btn btn-primary rounded-pill py-3 px-5"><i class="fa fa-shopping-bag me-2"></i>Add to cart</button>
                    </form>
                    <a asp-controller="HangHoa" asp-action="Index" class="btn btn-outline-primary border-2 rounded-pill py-3 px-5">Back</a>
                </div>
            </div>
        </div>
    </div>
</div>
