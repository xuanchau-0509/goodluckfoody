@model ProductListViewModel

@{
    ViewData["Title"] = Model.CurrentCategoryName;
}

<div class="container-fluid page-header mb-5 wow fadeIn" data-wow-delay="0.1s">
    <div class="container">
        <h1 class="display-3 mb-3 animated slideInDown">@Model.CurrentCategoryName</h1>
        <nav aria-label="breadcrumb animated slideInDown">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a class="text-body" asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item text-dark active" aria-current="page">Products</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container-xxl py-5">
    <div class="container">
        <div class="row g-0 gx-5 align-items-end">
            <div class="col-lg-6">
                <div class="section-header text-start mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 500px;">
                    <h1 class="display-5 mb-3">Our Products</h1>
                    <p>Browse organic products by category. The list below is served by MVC instead of static HTML.</p>
                </div>
            </div>
            <div class="col-lg-6 text-start text-lg-end wow slideInRight" data-wow-delay="0.1s">
                @await Component.InvokeAsync("MenuLoai", new { currentCategoryId = Model.CurrentCategoryId })
            </div>
        </div>

        @if (Model.Products.Count == 0)
        {
            <div class="alert alert-info">No products found in this category.</div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var product in Model.Products)
                {
                    @await Html.PartialAsync("_ProductCard", product)
                }
            </div>
        }
    </div>
</div>
