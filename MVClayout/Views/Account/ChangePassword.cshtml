@model MVClayout.Models.ChangePasswordViewModel

@{
    ViewData["Title"] = "Đổi mật khẩu";
    Layout = "~/Views/Shared/_LayoutCustomer.cshtml";
}

<div class="container-xxl py-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-4 mb-4 mb-lg-0">
                <div class="bg-light rounded p-4 mb-4 wow fadeInUp" data-wow-delay="0.1s">
                    <div class="d-flex flex-column gap-2">
                        <a asp-action="Profile" class="btn btn-outline-primary w-100">Thông tin cá nhân</a>
                        <a asp-action="ChangePassword" class="btn btn-primary w-100">Đổi mật khẩu</a>
                        <form asp-action="Logout" method="post" class="w-100 mt-2">
                            <button type="submit" class="btn btn-danger w-100">Đăng xuất</button>
                        </form>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-8">
                <div class="bg-light rounded p-5 wow fadeInUp" data-wow-delay="0.3s">
                    <h2 class="mb-4">Đổi mật khẩu</h2>

                    <form asp-action="ChangePassword" method="post">
                        <div class="row g-3">
                            <div class="col-12">
                                <div class="form-floating">
                                    <input asp-for="CurrentPassword" class="form-control" type="password" />
                                    <label asp-for="CurrentPassword">Mật khẩu hiện tại</label>
                                    <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-floating">
                                    <input asp-for="NewPassword" class="form-control" type="password" />
                                    <label asp-for="NewPassword">Mật khẩu mới</label>
                                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-floating">
                                    <input asp-for="ConfirmNewPassword" class="form-control" type="password" />
                                    <label asp-for="ConfirmNewPassword">Xác nhận mật khẩu mới</label>
                                    <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-12 mt-4">
                                <button class="btn btn-primary rounded-pill py-3 px-5" type="submit">Đổi mật khẩu</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
