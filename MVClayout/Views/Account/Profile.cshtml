@model MVClayout.Models.ProfileViewModel

@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    Layout = "~/Views/Shared/_LayoutCustomer.cshtml";
}

<div class="container-xxl py-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-4 mb-4 mb-lg-0">
                <div class="bg-light rounded p-4 mb-4 wow fadeInUp" data-wow-delay="0.1s">
                    <div class="text-center mb-4">
                        <div class="bg-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 100px; height: 100px;">
                            <i class="fa fa-user fa-3x text-primary"></i>
                        </div>
                        <h4 class="mb-0">@Model.FullName</h4>
                        <p class="text-muted mb-0">@@@Model.Username</p>
                    </div>
                    <div class="d-flex flex-column gap-2">
                        <a asp-action="Profile" class="btn btn-primary w-100">Thông tin cá nhân</a>
                        <a asp-action="ChangePassword" class="btn btn-outline-primary w-100">Đổi mật khẩu</a>
                        <form asp-action="Logout" method="post" class="w-100 mt-2">
                            <button type="submit" class="btn btn-danger w-100">Đăng xuất</button>
                        </form>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-8">
                <div class="bg-light rounded p-5 wow fadeInUp" data-wow-delay="0.3s">
                    <h2 class="mb-4">Thông tin cá nhân</h2>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="Profile" method="post">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Username" class="form-control" readonly disabled />
                                    <label asp-for="Username">Tên đăng nhập</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Email" class="form-control" />
                                    <label asp-for="Email">Email *</label>
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-floating">
                                    <input asp-for="FullName" class="form-control" />
                                    <label asp-for="FullName">Họ và tên *</label>
                                    <span asp-validation-for="FullName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Phone" class="form-control" />
                                    <label asp-for="Phone">Số điện thoại</label>
                                    <span asp-validation-for="Phone" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="CreatedDate" class="form-control" readonly disabled />
                                    <label>Ngày tham gia</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-floating">
                                    <input asp-for="Address" class="form-control" />
                                    <label asp-for="Address">Địa chỉ</label>
                                    <span asp-validation-for="Address" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-12 mt-4">
                                <button class="btn btn-primary rounded-pill py-3 px-5" type="submit">Cập nhật thông tin</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
