@model Order

@{
    ViewData["Title"] = "Order Confirmed";
}

<div class="container-fluid page-header mb-5 wow fadeIn" data-wow-delay="0.1s">
    <div class="container">
        <h1 class="display-3 mb-3 animated slideInDown">Order Confirmed</h1>
        <nav aria-label="breadcrumb animated slideInDown">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a class="text-body" asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item text-dark active" aria-current="page">Order Confirmed</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container-xxl py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 wow fadeIn" data-wow-delay="0.1s">
                <div class="text-center mb-5">
                    <div class="bg-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 80px; height: 80px;">
                        <i class="fa fa-check text-white fa-2x"></i>
                    </div>
                    <h1 class="display-5 mb-3">Thank you for your order!</h1>
                    <p class="text-muted">Your order has been placed successfully. Below are your order details.</p>
                </div>

                <div class="bg-light rounded p-4 mb-4">
                    <h4 class="mb-3">Order Information</h4>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <p class="mb-1 text-muted">Order ID</p>
                            <p class="fw-bold">#@Model.Id</p>
                        </div>
                        <div class="col-sm-6">
                            <p class="mb-1 text-muted">Order Date</p>
                            <p class="fw-bold">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                        <div class="col-sm-6">
                            <p class="mb-1 text-muted">Customer Name</p>
                            <p class="fw-bold">@Model.CustomerName</p>
                        </div>
                        <div class="col-sm-6">
                            <p class="mb-1 text-muted">Phone</p>
                            <p class="fw-bold">@Model.Phone</p>
                        </div>
                        <div class="col-12">
                            <p class="mb-1 text-muted">Delivery Address</p>
                            <p class="fw-bold">@Model.Address</p>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.Email))
                        {
                            <div class="col-sm-6">
                                <p class="mb-1 text-muted">Email</p>
                                <p class="fw-bold">@Model.Email</p>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Note))
                        {
                            <div class="col-12">
                                <p class="mb-1 text-muted">Note</p>
                                <p class="fw-bold">@Model.Note</p>
                            </div>
                        }
                    </div>
                </div>

                <div class="bg-light rounded p-4 mb-4">
                    <h4 class="mb-3">Order Details</h4>
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-center">Qty</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var detail in Model.OrderDetails)
                                {
                                    <tr>
                                        <td>@detail.ProductName</td>
                                        <td class="text-end">@detail.UnitPrice.ToString("N0") VND</td>
                                        <td class="text-center">@detail.Quantity</td>
                                        <td class="text-end">@detail.LineTotal.ToString("N0") VND</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="d-flex justify-content-between border-top pt-3">
                        <h5>Grand Total</h5>
                        <h5 class="text-primary">@Model.TotalAmount.ToString("N0") VND</h5>
                    </div>
                </div>

                <div class="text-center">
                    <a asp-controller="HangHoa" asp-action="Index" class="btn btn-primary rounded-pill py-3 px-5">
                        <i class="fa fa-shopping-bag me-2"></i>Continue Shopping
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary rounded-pill py-3 px-5 ms-2">
                        <i class="fa fa-home me-2"></i>Back to Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
