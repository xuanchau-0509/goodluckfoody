@{
    ViewData["Title"] = "About Us";
}

<div class="container-fluid page-header mb-5 wow fadeIn" data-wow-delay="0.1s">
    <div class="container">
        <h1 class="display-3 mb-3 animated slideInDown">About Us</h1>
        <nav aria-label="breadcrumb animated slideInDown">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a class="text-body" asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item text-dark active" aria-current="page">About Us</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container-xxl py-5">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6 wow fadeIn" data-wow-delay="0.1s">
                <div class="about-img position-relative overflow-hidden p-5 pe-0">
                    <img class="img-fluid w-100" src="~/img/about.jpg" alt="About Foody">
                </div>
            </div>
            <div class="col-lg-6 wow fadeIn" data-wow-delay="0.5s">
                <h1 class="display-5 mb-4">A Small MVC Storefront For Organic Food</h1>
                <p class="mb-4">This project demonstrates how a static HTML template can become an ASP.NET Core MVC site with controllers, shared layout, partial views, and reusable product components.</p>
                <p><i class="fa fa-check text-primary me-3"></i>Layout shared across every page</p>
                <p><i class="fa fa-check text-primary me-3"></i>Product list generated from server-side data</p>
                <p><i class="fa fa-check text-primary me-3"></i>Category menu rendered by ViewComponent</p>
            </div>
        </div>
    </div>
</div>
