@model HomeIndexViewModel

@{
    ViewData["Title"] = "Home";
}

<div class="container-fluid p-0 mb-5 wow fadeIn" data-wow-delay="0.1s">
    <div id="header-carousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img class="w-100" src="~/img/carousel-1.jpg" alt="Organic food">
                <div class="carousel-caption">
                    <div class="container">
                        <div class="row justify-content-start">
                            <div class="col-lg-7">
                                <h1 class="display-2 mb-5 animated slideInDown">Organic Food Is Good For Health</h1>
                                <a asp-controller="HangHoa" asp-action="Index" class="btn btn-primary rounded-pill py-sm-3 px-sm-5">Products</a>
                                <a asp-controller="Home" asp-action="About" class="btn btn-secondary rounded-pill py-sm-3 px-sm-5 ms-3">About Us</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="carousel-item">
                <img class="w-100" src="~/img/carousel-2.jpg" alt="Natural food">
                <div class="carousel-caption">
                    <div class="container">
                        <div class="row justify-content-start">
                            <div class="col-lg-7">
                                <h1 class="display-2 mb-5 animated slideInDown">Natural Food Is Always Healthy</h1>
                                <a asp-controller="HangHoa" asp-action="Index" class="btn btn-primary rounded-pill py-sm-3 px-sm-5">Products</a>
                                <a asp-controller="Home" asp-action="Contact" class="btn btn-secondary rounded-pill py-sm-3 px-sm-5 ms-3">Contact</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#header-carousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#header-carousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
</div>

<div class="container-xxl py-5">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6 wow fadeIn" data-wow-delay="0.1s">
                <div class="about-img position-relative overflow-hidden p-5 pe-0">
                    <img class="img-fluid w-100" src="~/img/about.jpg" alt="About Foody">
                </div>
            </div>
            <div class="col-lg-6 wow fadeIn" data-wow-delay="0.5s">
                <h1 class="display-5 mb-4">Best Organic Fruits And Vegetables</h1>
                <p class="mb-4">Foody brings fresh produce, clean ingredients, and simple healthy choices into one MVC storefront.</p>
                <p><i class="fa fa-check text-primary me-3"></i>Fresh products selected every day</p>
                <p><i class="fa fa-check text-primary me-3"></i>Clear categories and product details</p>
                <p><i class="fa fa-check text-primary me-3"></i>Ready to connect with a real database later</p>
                <a asp-controller="Home" asp-action="About" class="btn btn-primary rounded-pill py-3 px-5 mt-3">Read More</a>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid bg-light bg-icon my-5 py-6">
    <div class="container">
        <div class="section-header text-center mx-auto mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 500px;">
            <h1 class="display-5 mb-3">Our Features</h1>
            <p>A compact MVC shop layout with reusable views, product cards, and category filtering.</p>
        </div>
        <div class="row g-4">
            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
                <div class="bg-white text-center h-100 p-4 p-xl-5">
                    <img class="img-fluid mb-4" src="~/img/icon-1.png" alt="Natural process">
                    <h4 class="mb-3">Natural Process</h4>
                    <p class="mb-4">Products are presented with simple, consistent information for customers.</p>
                    <a asp-controller="HangHoa" asp-action="Index" class="btn btn-outline-primary border-2 py-2 px-4 rounded-pill">View Products</a>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.3s">
                <div class="bg-white text-center h-100 p-4 p-xl-5">
                    <img class="img-fluid mb-4" src="~/img/icon-2.png" alt="Organic products">
                    <h4 class="mb-3">Organic Products</h4>
                    <p class="mb-4">Category navigation is handled by a proper ASP.NET Core ViewComponent.</p>
                    <a asp-controller="HangHoa" asp-action="Index" class="btn btn-outline-primary border-2 py-2 px-4 rounded-pill">Browse</a>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.5s">
                <div class="bg-white text-center h-100 p-4 p-xl-5">
                    <img class="img-fluid mb-4" src="~/img/icon-3.png" alt="Clean layout">
                    <h4 class="mb-3">MVC Layout</h4>
                    <p class="mb-4">The static template is now wired through controllers, views, partials, and routing.</p>
                    <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-primary border-2 py-2 px-4 rounded-pill">Contact</a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-xxl py-5">
    <div class="container">
        <div class="row g-0 gx-5 align-items-end">
            <div class="col-lg-6">
                <div class="section-header text-start mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 500px;">
                    <h1 class="display-5 mb-3">Featured Products</h1>
                    <p>Start with a few highlighted products, then open the product page to filter by category.</p>
                </div>
            </div>
            <div class="col-lg-6 text-start text-lg-end wow slideInRight" data-wow-delay="0.1s">
                <a asp-controller="HangHoa" asp-action="Index" class="btn btn-primary rounded-pill py-3 px-5">All Products</a>
            </div>
        </div>
        <div class="row g-4">
            @foreach (var product in Model.FeaturedProducts)
            {
                @await Html.PartialAsync("_ProductCard", product)
            }
        </div>
    </div>
</div>
