@model Product

<div class="col-xl-3 col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
    <div class="product-item">
        <div class="position-relative bg-light overflow-hidden">
            <img class="img-fluid w-100" src="@Url.Content(Model.ImageUrl)" alt="@Model.Name">
            <div class="bg-secondary rounded text-white position-absolute start-0 top-0 m-4 py-1 px-3">@Model.Badge</div>
        </div>
        <div class="text-center p-4">
            <a asp-controller="HangHoa" asp-action="Details" asp-route-id="@Model.Id" class="d-block h5 mb-2">@Model.Name</a>
            <span class="text-primary me-1">@Model.Price.ToString("N0") VND</span>
            <span class="text-body text-decoration-line-through">@Model.OldPrice.ToString("N0") VND</span>
        </div>
        <div class="d-flex border-top">
            <small class="w-50 text-center border-end py-2">
                <a asp-controller="HangHoa" asp-action="Details" asp-route-id="@Model.Id" class="text-body">
                    <i class="fa fa-eye text-primary me-2"></i>View detail
                </a>
            </small>
            <small class="w-50 text-center py-2">
                <form asp-controller="Cart" asp-action="Add" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <input type="hidden" name="quantity" value="1" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                    <button type="submit" class="text-body border-0 bg-transparent p-0">
                        <i class="fa fa-shopping-bag text-primary me-2"></i>Add to cart
                    </button>
                </form>
            </small>
        </div>
    </div>
</div>
